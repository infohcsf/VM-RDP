{
  "name": "Windows 10 VM",
  "forwardPorts": [6080, 3389],
  "portsAttributes": {
    "6080": {
      "label": "Windows Desktop (noVNC)",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    },
    "3389": {
      "label": "RDP Port",
      "visibility": "public"
    }
  },
  "postStartCommand": "docker compose up -d --build"
}
